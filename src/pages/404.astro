---
import Base from '../layouts/Base.astro';
---

<Base title="页面不见了 · 我的个人网站" description="页面不存在" pageClass="notfound">
  <div class="notfound">
    <div class="notfound-emoji">🙇</div>
    <h1>这页找不到了</h1>
    <p class="notfound-desc">
      链接可能失效了，或者地址打错了一个字。<br />
      要不回<a href="/">首页</a>，或者去<a href="/blog/">博客</a>看看。
    </p>
  </div>

  <style>
    .notfound {
      min-height: 480px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 24px;
    }

    .notfound-emoji {
      font-size: 64px;
      line-height: 1;
      margin-bottom: 16px;
      user-select: none;
    }

    @media (min-width: 576px) {
      .notfound-emoji {
        font-size: 88px;
        margin-bottom: 20px;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .notfound-emoji:hover {
        animation: notfound-bounce 0.2s ease-in-out infinite;
      }
    }

    @keyframes notfound-bounce {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }

    .notfound h1 {
      margin: 0;
      font-size: 26px;
      font-weight: 600;
      color: var(--primary-text-color);
    }

    @media (min-width: 576px) {
      .notfound h1 {
        font-size: 36px;
      }
    }

    .notfound-desc {
      margin: 16px 0 0;
      font-size: 15px;
      line-height: 1.8;
      color: var(--secondary-text-color);
    }

    .notfound-desc a {
      color: var(--link-text-color);
    }
  </style>
</Base>

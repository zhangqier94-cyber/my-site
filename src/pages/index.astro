---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { companies, type Company } from '../data/companies';

const allProjects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// 按公司分组（顺序跟 src/data/companies.ts 走），没配公司的作品归入「其他作品」
interface Group extends Company { items: typeof allProjects; }
const groups: Group[] = companies
  .map(c => ({ ...c, items: allProjects.filter(p => p.data.company === c.id) }))
  .filter(g => g.items.length > 0);

const orphans = allProjects.filter(p => !companies.some(c => c.id === p.data.company));
if (orphans.length > 0) {
  groups.push({ id: 'others', name: '其他作品', order: 99, items: orphans });
}
---

<Base title="作品 · 我的个人网站" description="我的作品集" pageClass="project">
  <!-- 自我介绍（对齐原站 .intro 结构） -->
  <div class="intro">
    <h1 class="aurthor">某某某</h1>
    <p class="desc">一名设计师 / 工程师，这里是我的个人网站，用来存放作品、博客和<span class="nowrap">思考。</span></p>
    <p class="desc">改这里：src/pages/index.astro 里的 .intro 区块，换成你自己的<span class="nowrap">介绍。</span></p>
    <div class="action">
      <div class="resume">
        <a href="/about/" title="了解更多">了解更多</a>
      </div>
      <div class="contact">
        <a href="/blog/" title="去博客看看">去博客看看&nbsp;<div class="emoji-hand">👋🏻</div></a>
      </div>
    </div>
  </div>

  <hr class="common" />

  <!-- 作品：按公司分组（对齐原站 .experience > .info + .showcase 结构） -->
  {groups.map(group => (
    <div class="experience">
      <div class="info">
        <div class="company">
          <div class="name">
            {group.icon && <span class="icon" style={`background:url('${group.icon}') no-repeat center/100%`}></span>}
            {group.name}
          </div>
          {group.period && <div class="year">{group.period}</div>}
        </div>
      </div>
      <div class="showcase">
        {group.items.map(project => (
          <div class="item">
            <a href={`/works/${project.id}/`} title={`${project.data.title} 详情`}>
              <div class="item-container">
                <img
                  class="lazyload"
                  data-src={project.data.cover || '/img/logo.svg'}
                  alt={project.data.title}
                />
                <h3 class="title">{project.data.title}</h3>
              </div>
              <div class="desc">{project.data.description}</div>
            </a>
          </div>
        ))}
      </div>
    </div>
  ))}
</Base>

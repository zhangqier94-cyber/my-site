---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { companies, type Company } from '../data/companies';
import { contact } from '../data/contact';

const allProjects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// 按公司分组（顺序跟 src/data/companies.ts 走）
interface Group extends Company { items: typeof allProjects; }
const groups: Group[] = companies
  .map(c => ({ ...c, items: allProjects.filter(p => p.data.company === c.id) }))
  .filter(g => g.items.length > 0);
---

<Base title="作品 · 我的个人网站" description="我的作品集" pageClass="project">
  <!-- 自我介绍（对齐原站 .intro 结构） -->
  <div class="intro">
    <h1 class="aurthor">某某某</h1>
    <p class="desc">一名设计师 / 工程师，这里是我的个人网站，用来存放作品、博客和<span class="nowrap">思考。</span></p>
    <p class="desc">改这里：src/pages/index.astro 里的 .intro 区块，换成你自己的<span class="nowrap">介绍。</span></p>
    <div class="action">
      <div class="resume">
        <a href="/about/" title="了解更多">了解更多</a>
      </div>
      <div class="contact">
        <a href="javascript:" id="contactBtn" title="联系方式">联系我&nbsp;<div class="emoji-hand">👋🏻</div></a>
      </div>
    </div>
  </div>

  <hr class="common" />

  <!-- 作品：按公司分组（对齐原站 .experience > .info + .showcase 结构） -->
  {groups.map(group => (
    <div class="experience">
      <div class="info">
        <div class="company">
          <div class="name">
            {group.icon && <img class="icon" src={group.icon} alt={group.name} />}
            {group.name}
          </div>
          {group.period && <div class="year">{group.period}</div>}
        </div>
      </div>
      <div class="showcase">
        {group.items.map(project => (
          <div class="item">
            <a href={`/works/${project.id}/`} title={`${project.data.title} 详情`}>
              <div class="item-container">
                <img
                  class="lazyload"
                  data-src={project.data.cover || '/img/logo.svg'}
                  alt={project.data.title}
                />
                <h3 class="title">{project.data.title}</h3>
              </div>
              <div class="desc">{project.data.description}</div>
            </a>
          </div>
        ))}
      </div>
    </div>
  ))}

  <!-- 联系我弹卡 -->
  <div class="contact-mask" id="contactMask" hidden>
    <div class="contact-card" role="dialog" aria-modal="true" aria-label="联系方式">
      <img class="qr" src={contact.wechatQr} alt="微信二维码" width="240" height="240" />
      <div class="title">扫一扫加我微信</div>
      <div class="or"><span>或</span></div>
      <button type="button" class="copy-btn" data-copy={contact.phone}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span class="copy-text">复制我的手机号</span>
      </button>
      <button type="button" class="copy-btn" data-copy={contact.email}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <span class="copy-text">复制我的 Email</span>
      </button>
    </div>
  </div>

  <script>
    const mask = document.getElementById('contactMask')!;
    const btn = document.getElementById('contactBtn')!;

    const openCard = () => { mask.hidden = false; requestAnimationFrame(() => mask.classList.add('show')); };
    const closeCard = () => {
      mask.classList.remove('show');
      setTimeout(() => { mask.hidden = true; }, 200);
    };

    btn.addEventListener('click', openCard);
    mask.addEventListener('click', e => { if (e.target === mask) closeCard(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && !mask.hidden) closeCard(); });

    // 复制 + 按钮反馈
    mask.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btnEl => {
      btnEl.addEventListener('click', async () => {
        const text = btnEl.dataset.copy || '';
        const label = btnEl.querySelector('.copy-text')!;
        try {
          await navigator.clipboard.writeText(text);
          label.textContent = '已复制 ✓';
        } catch {
          label.textContent = text; // 复制失败时直接展示内容
        }
        setTimeout(() => { label.textContent = btnEl.dataset.label!; }, 1600);
      });
      btnEl.dataset.label = btnEl.querySelector('.copy-text')!.textContent || '';
    });
  </script>
</Base>

---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const byYear = posts.reduce((acc, p) => {
  const y = p.data.pubDate.getFullYear();
  (acc[y] ||= []).push(p);
  return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---

<Base title="归档 · 我的个人网站" description="所有文章按年份归档" pageClass="blog">
  <div class="blog-divider"><span class="blog-divider-title">归档 · 共 {posts.length} 篇</span></div>

  {years.map(year => (
    <>
      <div class="blog-divider"><span class="blog-divider-title">{year} 年 · {byYear[year].length} 篇</span></div>
      <div class="blog-list">
        {byYear[year].map(post => (
          <section>
            <a href={`/blog/${post.id}/`}>
              <h2>{post.data.title}</h2>
              {post.data.description && <p class="blog-subtitle">{post.data.description}</p>}
            </a>
            <p class="blog-author">
              {String(post.data.pubDate.getMonth() + 1).padStart(2, '0')}-{String(post.data.pubDate.getDate()).padStart(2, '0')}
            </p>
          </section>
        ))}
      </div>
    </>
  ))}
</Base>